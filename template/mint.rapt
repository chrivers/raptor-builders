FROM docker://linuxmintd/mint22-amd64

INCLUDE basic-setup nameserver="1.1.1.1" hostname="mint"

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get -qy update
RUN apt-get -qy install linux-image-generic systemd-sysv grub-efi

RUN usermod -p "" root

RUN sed -i -re "s|^GRUB_TIMEOUT=0|GRUB_TIMEOUT=5|; s|^GRUB_TIMEOUT_STYLE=hidden|\\x23\\0|"  /etc/default/grub

MKDIR -p /boot/efi/EFI/BOOT
MKDIR -p /boot/grub/fonts
RUN cp /usr/share/grub/unicode.pf2 /boot/grub/fonts/unicode.pf2
