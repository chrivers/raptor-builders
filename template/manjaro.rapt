FROM docker://manjarolinux/base

INCLUDE basic-setup nameserver="1.1.1.1" hostname="manjaro"

RUN pacman -Sy --noconfirm systemd systemd-sysvcompat zsh grub linux mkinitcpio efibootmgr

RUN usermod -p "" root

RUN sed -i -re "s|^GRUB_TIMEOUT=0|GRUB_TIMEOUT=5|; s|^GRUB_TIMEOUT_STYLE=hidden|\\x23\\0|"  /etc/default/grub

MKDIR -p /boot/efi/EFI/BOOT
MKDIR -p /boot/grub/fonts
RUN cp /usr/share/grub/unicode.pf2 /boot/grub/fonts/unicode.pf2
